// src/components/layout/app-shell.tsx
'use client';

import Link from 'next/link';
import { usePathname } from 'next/navigation';
import { cn } from '@/lib/utils';
import { Button } from '@/components/ui/button';
import { createBrowserSupabaseClient } from '@/lib/supabase';
import { useRouter } from 'next/navigation';
import {
  LayoutDashboard,
  Users,
  FileText,
  GraduationCap,
  Calendar,
  Settings,
  LogOut,
  Bell,
  Shield,
} from 'lucide-react';

interface NavItem {
  label: string;
  href: string;
  icon: React.ReactNode;
}

interface AppShellProps {
  children: React.ReactNode;
  role: string;
  userName: string;
}

const navConfig: Record<string, NavItem[]> = {
  ADMINISTRATEUR: [
    { label: 'Tableau de bord', href: '/admin/dashboard', icon: <LayoutDashboard className="h-4 w-4" /> },
    { label: 'Candidats', href: '/admin/candidates', icon: <Users className="h-4 w-4" /> },
    { label: 'Doctorants', href: '/admin/students', icon: <GraduationCap className="h-4 w-4" /> },
    { label: 'Inscriptions', href: '/admin/enrollments', icon: <FileText className="h-4 w-4" /> },
    { label: 'Paiements', href: '/admin/payments', icon: <Shield className="h-4 w-4" /> },
    { label: 'Comités', href: '/admin/committees', icon: <Calendar className="h-4 w-4" /> },
    { label: 'Soutenances', href: '/admin/defenses', icon: <GraduationCap className="h-4 w-4" /> },
    { label: 'Paramètres', href: '/admin/settings', icon: <Settings className="h-4 w-4" /> },
  ],
  DOCTORANT: [
    { label: 'Tableau de bord', href: '/doctorant/dashboard', icon: <LayoutDashboard className="h-4 w-4" /> },
    { label: 'Mon dossier', href: '/doctorant/dossier', icon: <FileText className="h-4 w-4" /> },
    { label: 'Inscriptions', href: '/doctorant/enrollments', icon: <GraduationCap className="h-4 w-4" /> },
    { label: 'Thèse', href: '/doctorant/thesis', icon: <FileText className="h-4 w-4" /> },
    { label: 'Documents', href: '/doctorant/documents', icon: <FileText className="h-4 w-4" /> },
    { label: 'Comité', href: '/doctorant/committee', icon: <Calendar className="h-4 w-4" /> },
  ],
  DIRECTEUR_DE_THESE: [
    { label: 'Tableau de bord', href: '/directeur/dashboard', icon: <LayoutDashboard className="h-4 w-4" /> },
    { label: 'Mes doctorants', href: '/directeur/students', icon: <GraduationCap className="h-4 w-4" /> },
  ],
  COMITE_DE_SUIVI: [
    { label: 'Tableau de bord', href: '/comite/dashboard', icon: <LayoutDashboard className="h-4 w-4" /> },
    { label: 'Réunions', href: '/comite/meetings', icon: <Calendar className="h-4 w-4" /> },
  ],
  CANDIDAT: [
    { label: 'Tableau de bord', href: '/candidate/dashboard', icon: <LayoutDashboard className="h-4 w-4" /> },
    { label: 'Ma candidature', href: '/candidate/applications', icon: <FileText className="h-4 w-4" /> },
  ],
};

export function AppShell({ children, role, userName }: AppShellProps) {
  const pathname = usePathname();
  const router = useRouter();
  const supabase = createBrowserSupabaseClient();
  const navItems = navConfig[role] || [];

  async function handleLogout() {
    await supabase.auth.signOut();
    router.push('/login');
    router.refresh();
  }

  return (
    <div className="flex min-h-screen bg-muted/20">
      <aside className="w-64 border-r bg-card flex flex-col">
        <div className="p-6 border-b">
          <h1 className="text-lg font-bold tracking-tight">Université Senghor</h1>
          <p className="text-xs text-muted-foreground">Plateforme Doctorale</p>
        </div>
        <nav className="flex-1 p-4 space-y-1">
          {navItems.map((item) => (
            <Link
              key={item.href}
              href={item.href}
              className={cn(
                'flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium transition-colors',
                pathname === item.href
                  ? 'bg-primary text-primary-foreground'
                  : 'text-muted-foreground hover:bg-accent hover:text-accent-foreground'
              )}
            >
              {item.icon}
              {item.label}
            </Link>
          ))}
        </nav>
        <div className="p-4 border-t space-y-3">
          <div className="text-sm font-medium truncate">{userName}</div>
          <Button variant="ghost" className="w-full justify-start gap-2 text-sm" onClick={handleLogout}>
            <LogOut className="h-4 w-4" />
            Déconnexion
          </Button>
        </div>
      </aside>
      <main className="flex-1 flex flex-col">
        <header className="h-14 border-b bg-card flex items-center justify-between px-6">
          <div className="text-sm text-muted-foreground">
            {navItems.find((n) => n.href === pathname)?.label || 'Plateforme Doctorale'}
          </div>
          <Button variant="ghost" size="icon">
            <Bell className="h-4 w-4" />
          </Button>
        </header>
        <div className="flex-1 p-6 overflow-auto">{children}</div>
      </main>
    </div>
  );
}
